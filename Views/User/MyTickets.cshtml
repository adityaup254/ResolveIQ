@model IEnumerable<ResolveIQ.Models.Ticket>
@{
    ViewData["Title"] = "My Tickets";
}

<div class="mt-4">
    <h2>My Tickets</h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <form method="get" class="row g-3 mb-4 mt-2">
        <div class="col-md-4">
            <input type="text" name="searchString" class="form-control" placeholder="Search by title..." value="@ViewData["CurrentSearch"]" />
        </div>
        <div class="col-md-3">
            <select name="statusFilter" class="form-select">
                <option value="">All Statuses</option>
                <option value="Open" selected="@(ViewData["CurrentStatus"]?.ToString() == "Open")">Open</option>
                <option value="Assigned" selected="@(ViewData["CurrentStatus"]?.ToString() == "Assigned")">Assigned</option>
                <option value="In Progress" selected="@(ViewData["CurrentStatus"]?.ToString() == "In Progress")">In Progress</option>
                <option value="Resolved" selected="@(ViewData["CurrentStatus"]?.ToString() == "Resolved")">Resolved</option>
                <option value="Closed" selected="@(ViewData["CurrentStatus"]?.ToString() == "Closed")">Closed</option>
            </select>
        </div>
        <div class="col-md-3">
            <select name="priorityFilter" class="form-select">
                <option value="">All Priorities</option>
                <option value="High" selected="@(ViewData["CurrentPriority"]?.ToString() == "High")">High</option>
                <option value="Medium" selected="@(ViewData["CurrentPriority"]?.ToString() == "Medium")">Medium</option>
                <option value="Low" selected="@(ViewData["CurrentPriority"]?.ToString() == "Low")">Low</option>
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">Filter</button>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Title</th>
                    <th>Category</th>
                    <th>Priority</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th>Technician</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Title</td>
                        <td>@item.Category?.Name</td>
                        <td>
                            <span class="badge bg-@(item.Priority == "High" ? "danger" : item.Priority == "Medium" ? "warning" : "info")">@item.Priority</span>
                        </td>
                        <td>
                            <span class="badge bg-@(item.Status == "Open" ? "primary" : item.Status == "Closed" || item.Status == "Resolved" ? "success" : "secondary")">@item.Status</span>
                        </td>
                        <td>@item.CreatedDate.ToShortDateString()</td>
                        <td>@(item.Technician?.FullName ?? "Unassigned")</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Details</a>
                            @if (item.Status == "Open")
                            {
                                <a asp-action="EditTicket" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                                <a asp-action="DeleteTicket" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center">No tickets found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
