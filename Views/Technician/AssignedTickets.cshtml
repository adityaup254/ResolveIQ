@model IEnumerable<ResolveIQ.Models.Ticket>
@{
    ViewData["Title"] = "Assigned Tickets";
}

<div class="mt-4">
    <h2>Tickets Assigned To Me</h2>

    <div class="table-responsive mt-3">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Title</th>
                    <th>User</th>
                    <th>Category</th>
                    <th>Priority</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Title</td>
                        <td>@item.User?.FullName</td>
                        <td>@item.Category?.Name</td>
                        <td>
                            <span class="badge bg-@(item.Priority == "High" ? "danger" : item.Priority == "Medium" ? "warning" : "info")">@item.Priority</span>
                        </td>
                        <td>
                            <span class="badge bg-@(item.Status == "Assigned" ? "primary" : item.Status == "Closed" || item.Status == "Resolved" ? "success" : "secondary")">@item.Status</span>
                        </td>
                        <td>@item.CreatedDate.ToShortDateString()</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">View / Update</a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center">No assigned tickets found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
